  "variants": [
    {
      "id": "matched_control",
      "role": "architecture-matched simple control",
      "contract": "mean fusion; no channel mask; no fused/channel MMD; no gradient projection",
      "claim_boundary": "This is the frozen v1 matched control, not a fully target-independent Source Only baseline because the shared preprocessing/calibration contract is retained."
    },
    {
      "id": "cra_v1_frozen",
      "role": "direct predecessor control",
      "contract": "unchanged CRA-v1 bounded fusion + mask + fused MMD + biased unequal-cardinality channel MMD + safe projection",
      "claim_boundary": "Must be reproduced from a freshly frozen v2 code snapshot; no reuse across task/target-mode identities unless every reuse key matches."
    },
    {
      "id": "cra_v2_no_channel_mmd",
      "role": "mechanism ablation",
      "contract": "same as CRA-v2 candidate except channel-MMD weight is exactly zero and the channel-MMD sampler is not consumed",
      "claim_boundary": "Isolates whether balanced channel alignment adds value beyond fusion, masking, fused MMD and projection."
    },
    {
      "id": "cra_v2_balanced_channel_mmd",
      "role": "candidate",
      "contract": "CRA-v1 full recipe with only channel-MMD sampling changed to equal B-by-B, physical-slot-stratified sampling; all loss weights and other algorithms frozen",
      "claim_boundary": "A performance gain can be attributed only to the sample-cardinality correction, not to a new architecture stack."
    }
  ],
